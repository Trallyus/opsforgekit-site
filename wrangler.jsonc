{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opsforgekit-site",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "opsforgekit.com", "custom_domain": true },
    { "pattern": "www.opsforgekit.com", "custom_domain": true }
  ]
}
